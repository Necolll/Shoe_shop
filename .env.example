# Скопируйте в .env (или запустите: bash setup.sh) и задайте свои значения.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me

# Имя, на которое выпускается самоподписанный сертификат
SERVER_NAME=localhost

# Порт, по которому HTTPS виден снаружи (нужен для редиректа с http).
# 443 — обычный случай; 8443 — если в VirtualBox проброшен 8443 -> 443
HTTPS_PUBLIC_PORT=443
